#!/bin/sh
# SPEC submit/setup_submit wrapper: run RISC-V ELF programs under QEMU user mode
# ($SPECPACK_QEMU, set by specpack from its settings) and anything else, such as
# SPEC's own x86 tools specxz and specperl, directly.
# Usage: rv-exec PROGRAM [ARGS...]
if [ -z "$SPECPACK_QEMU" ]; then
  echo "rv-exec: SPECPACK_QEMU is not set" >&2
  exit 127
fi
path=$1
case $path in
  */*) ;;
  *) path=$(command -v -- "$1" 2>/dev/null || echo "$1") ;;
esac
# ELF magic, then e_machine 243 (EM_RISCV) at offset 18, little-endian.
if [ -f "$path" ] && [ "$(od -An -tx1 -N4 "$path" | tr -d ' ')" = 7f454c46 ] \
   && [ "$(od -An -tu2 -j18 -N2 "$path" | tr -d ' ')" = 243 ]; then
  exec "$SPECPACK_QEMU" "$@"
fi
exec "$@"
